# ── BOTChain Mainnet deployment (Hardhat) ──────────────────────────────
# RPC endpoint for BOTChain Mainnet (fill in the official endpoint)
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
# Numeric chain ID of BOTChain Mainnet
BOTCHAIN_CHAIN_ID=677
# Deployer private key — NEVER commit a real key
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Protocol treasury address that receives the 3% settlement fee
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS

# ── Frontend (Vite — must be prefixed with VITE_) ──────────────────────
VITE_BOTCHAIN_RPC_URL=https://rpc.botchain.ai
VITE_BOTCHAIN_CHAIN_ID=677
VITE_BOTCHAIN_EXPLORER_URL=https://scan.botchain.ai
VITE_INVOICE_NFT_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_SENTRY_REGISTRY_ADDRESS=
# Block number of the deployment tx — speeds up event-log reads (optional)
VITE_DEPLOY_BLOCK=0
