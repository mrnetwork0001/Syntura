# Syntura autonomous AI Risk Sentry - service configuration.
# Copy to service/.env and fill in SENTRY_PRIVATE_KEY. Never commit service/.env.
# This file is also loaded verbatim by systemd (EnvironmentFile), so keep every
# line a bare KEY=VALUE with no quotes, no `export`, and no trailing comments.

# ── Chain ──────────────────────────────────────────────────────────────
BOTCHAIN_RPC_URL=https://rpc.botchain.ai

# ── Sentry identity ────────────────────────────────────────────────────
# Dedicated key for THIS service only. Never reuse the deployer/owner key and
# never place a real key in any committed file.
# The owner must register the matching address:
#   SynturaSentryRegistry.registerSentry(<address>, "syntura-sentry-v1")
SENTRY_PRIVATE_KEY=0xYOUR_SENTRY_KEY

# ── Deployed contracts (BOT Chain Mainnet, chain 677) ──────────────────
INVOICE_NFT_ADDRESS=0xD8816ecf2D243f4B5328502ACAB83a9dF043A40a
SENTRY_REGISTRY_ADDRESS=0x19B0c0BB8A654b950739B84776A5951BA4ABf676

# ── Watcher tuning ─────────────────────────────────────────────────────
# First block that can contain protocol events (the deploy block).
START_BLOCK=19906390
# Poll interval between passes, milliseconds.
POLL_MS=6000
# State file (relative paths resolve against the service directory).
STATE_FILE=./state.json
# Maximum block span per eth_getLogs request.
MAX_BLOCK_SPAN=2000
# Confirmations awaited per transaction, and blocks held back from log scans.
CONFIRMATIONS=1
# debug | info | warn | error
LOG_LEVEL=info
